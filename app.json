import React, { useState, useEffect } from 'react';
import { StyleSheet, Text, View, TouchableOpacity, TextInput, Alert, ScrollView, SafeAreaView } from 'react-native';
import * as WebBrowser from 'expo-web-browser';
import * as AuthSession from 'expo-auth-session';
import { supabase } from './lib/supabase';

// This is the "Traffic Controller" for the login popup
WebBrowser.maybeCompleteAuthSession();

export default function App() {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(false);

  // REGISTRATION FIELDS (Add all your "way more info" variables here)
  const [major, setMajor] = useState('');
  const [year, setYear] = useState('');
  const [budget, setBudget] = useState('');
  const [bio, setBio] = useState('');

  useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      setUser(session?.user ?? null);
    });
    supabase.auth.onAuthStateChange((_event, session) => {
      setUser(session?.user ?? null);
    });
  }, []);

  const handleLogin = async () => {
    // This generates the specific link: popmatch://
    const redirectTo = AuthSession.makeRedirectUri({
      scheme: 'popmatch',
      path: 'auth-callback', // Adding a specific path can help prevent 404s
    });

    const { data, error } = await supabase.auth.signInWithOAuth({
      provider: 'azure',
      options: { 
        redirectTo,
        skipBrowserRedirect: true,
      },
    });

    if (error) return Alert.alert("Login Error", error.message);

    // This opens the UIUC login screen
    const result = await WebBrowser.openAuthSessionAsync(data.url, redirectTo);

    if (result.type === 'success') {
      const { params } = AuthSession.parseDeepLink(result.url);
      if (params.access_token) {
        await supabase.auth.setSession({
          access_token: params.access_token,
          refresh_token: params.refresh_token,
        });
      }
    }
  };

  const saveProfile = async () => {
    setLoading(true);
    const { error } = await supabase
      .from('profiles')
      .update({ 
        major, 
        graduation_year: year, 
        budget, 
        bio 
      })
      .eq('id', user.id);

    setLoading(false);
    if (error) Alert.alert("Error", error.message);
    else Alert.alert("Success!", "Profile Saved!");
  };

  return (
    <SafeAreaView style={styles.container}>
      <ScrollView contentContainerStyle={styles.content}>
        {!user ? (
          <View style={styles.center}>
            <Text style={styles.logo}>PopMatch</Text>
            <TouchableOpacity style={styles.loginButton} onPress={handleLogin}>
              <Text style={styles.buttonText}>Log in with NetID</Text>
            </TouchableOpacity>
          </View>
        ) : (
          <View style={styles.formCard}>
            <Text style={styles.headerText}>Welcome, {user.email}</Text>

            <Text style={styles.label}>Major</Text>
            <TextInput style={styles.input} value={major} onChangeText={setMajor} />

            <Text style={styles.label}>Year</Text>
            <TextInput style={styles.input} value={year} onChangeText={setYear} keyboardType="numeric" />

            <Text style={styles.label}>Budget</Text>
            <TextInput style={styles.input} value={budget} onChangeText={setBudget} keyboardType="numeric" />

            <Text style={styles.label}>Bio</Text>
            <TextInput style={[styles.input, { height: 80 }]} value={bio} onChangeText={setBio} multiline />

            <TouchableOpacity style={styles.saveButton} onPress={saveProfile} disabled={loading}>
              <Text style={styles.buttonText}>{loading ? "Saving..." : "Register"}</Text>
            </TouchableOpacity>

            <TouchableOpacity onPress={() => supabase.auth.signOut()}>
              <Text style={styles.signOut}>Sign Out</Text>
            </TouchableOpacity>
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#E1F5FE' },
  content: { flexGrow: 1, justifyContent: 'center', padding: 20 },
  center: { alignItems: 'center' },
  logo: { fontSize: 48, fontWeight: '900', color: '#FF7043', marginBottom: 40 },
  loginButton: { backgroundColor: '#FF7043', padding: 20, borderRadius: 50 },
  buttonText: { color: 'white', fontWeight: 'bold', fontSize: 16 },
  formCard: { backgroundColor: 'white', padding: 25, borderRadius: 20 },
  headerText: { fontSize: 18, color: '#333', marginBottom: 20, fontWeight: 'bold' },
  label: { fontSize: 12, color: '#0288D1', fontWeight: 'bold', marginTop: 10 },
  input: { backgroundColor: '#F0F4F8', padding: 12, borderRadius: 10, marginTop: 5 },
  saveButton: { backgroundColor: '#FF7043', padding: 15, borderRadius: 50, marginTop: 20, alignItems: 'center' },
  signOut: { textAlign: 'center', color: '#999', marginTop: 20, textDecorationLine: 'underline' }
});
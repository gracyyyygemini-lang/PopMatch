# Copy to .env and fill in. .env is gitignored — never commit real values.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and visible to
# anyone who opens it, so only public-safe values belong there.

# ─── Supabase (client) ───────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Supabase (server) ───────────────────────────────────────────────────────
# Dashboard -> Project Settings -> Database -> Connection string (URI).
# Contains your database password — server-side only, never EXPO_PUBLIC_.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# If this direct connection won't connect from your network (Supabase's
# direct host is IPv6-only, and plenty of home/campus networks are IPv4-only),
# use the "Session pooler" string from the same Connect page instead — it
# looks like postgresql://postgres.your-project-ref:PASSWORD@aws-...pooler.supabase.com:5432/postgres

# ─── Where the app is served ─────────────────────────────────────────────────
# Leave these unset for local development. In development the app always calls
# http://localhost:5000 — on web too, because Expo serves the web app from
# :8081 and answers unknown paths (including /api/*) with its own HTML. Only a
# production web build talks to its own origin.
#
# If you change PORT (API server section below), repeat it here so the app can find the API (only
# EXPO_PUBLIC_* variables are visible to the app):
# EXPO_PUBLIC_API_PORT=5000
#
# In production set EXPO_PUBLIC_DOMAIN to the host serving the app, e.g.
#   EXPO_PUBLIC_DOMAIN=popmatch.app
# Set EXPO_PUBLIC_API_URL only if the API lives somewhere else entirely.
# EXPO_PUBLIC_DOMAIN=
# EXPO_PUBLIC_API_URL=

# Development only: fill the swipe deck with the hardcoded MOCK_USERS instead
# of real profiles from the users table.
# EXPO_PUBLIC_USE_MOCK_USERS=true

# ─── API server ──────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated sites allowed to call the API from a different origin.
# Unnecessary when one server serves both the app and /api.
# ALLOWED_ORIGINS=https://popmatch.app

# Every /api request must carry the student's Supabase access token. The
# server checks it against the project's public signing keys, fetched from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json — no secret needed here. It
# uses EXPO_PUBLIC_SUPABASE_URL above unless SUPABASE_URL is set (only needed
# if the server runs somewhere that doesn't get the EXPO_PUBLIC_ vars).
# SUPABASE_URL=https://your-project-ref.supabase.co

# Account deletion (Profile -> Delete Account) removes the student's Supabase
# sign-in and their photos in Storage, which needs the service role key:
# Dashboard -> Project Settings -> API -> service_role. It bypasses every
# security rule, so it's server-side only — never EXPO_PUBLIC_, never in the
# app. Unset, DELETE /api/account refuses (503) and deletes nothing.
# SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated sign-in emails allowed to see /api/admin/stats and
# /api/feedback/summary (the admin dashboard). Unset means nobody can.
# ADMIN_EMAILS=you@illinois.edu,cofounder@illinois.edu

# ─── Microsoft / UIUC sign-in ────────────────────────────────────────────────
# Nothing goes here. "Continue with UIUC" is the primary sign-in and is always
# shown; it is configured entirely in the Supabase dashboard under
# Authentication -> Providers -> Azure (client ID + secret from your Azure app
# registration). See SETUP.md for the walkthrough.

# ─── App Review demo account ────────────────────────────────────────────────
# No variables: the address and code are hardcoded in server/reviewLogin.ts
# and need SUPABASE_SERVICE_ROLE_KEY. See SETUP.md, "App Review demo account".

# ─── Safety: reports and contact (App Store guideline 1.2) ──────────────────
# Shown in the app as "Contact us" (Profile) and on the report confirmation.
# Unset hides both, and App Review expects published contact info, so set it.
# EXPO_PUBLIC_SUPPORT_EMAIL=
#
# Each new report emails everyone in ADMIN_EMAILS through Resend. The sender
# must be on a domain verified in Resend. See SETUP.md, "Reports and alerts".
# RESEND_API_KEY=
# REPORTS_FROM_EMAIL=PopMatch Reports <reports@your-domain>

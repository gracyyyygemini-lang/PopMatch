# ─── Expo (app) ─────────────────────────────────────────────────────────────
# Public host for the Express API (same origin as your deployed server).
EXPO_PUBLIC_DOMAIN=your-host.example.com:5000

# Set to 1 to use Supabase-backed MVP APIs (profile, listings, images, chat).
EXPO_PUBLIC_BACKEND_MVP=0

# ─── Express server ──────────────────────────────────────────────────────────
# Legacy Postgres (friends, OTP, admin, stats) — still used when tables exist.
DATABASE_URL=postgresql://user:pass@host:5432/db

# Supabase project (MVP listings, profiles, chat, Storage). When both are set,
# MVP routes replace legacy /api/listings and /api/conversations for those paths.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Firebase Admin — JSON string of the service account key (or use
# GOOGLE_APPLICATION_CREDENTIALS pointing at a key file on disk).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

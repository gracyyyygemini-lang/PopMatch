# Copy to .env and fill in. .env is gitignored — never commit real values.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and visible to
# anyone who opens it, so only public-safe values belong there.

# ─── Supabase (client) ───────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Supabase (server) ───────────────────────────────────────────────────────
# Dashboard -> Project Settings -> Database -> Connection string (URI).
# Contains your database password — server-side only, never EXPO_PUBLIC_.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# If this direct connection won't connect from your network (Supabase's
# direct host is IPv6-only, and plenty of home/campus networks are IPv4-only),
# use the "Session pooler" string from the same Connect page instead — it
# looks like postgresql://postgres.your-project-ref:PASSWORD@aws-...pooler.supabase.com:5432/postgres

# ─── Where the app is served ─────────────────────────────────────────────────
# Leave both unset for local development: the web build talks to its own
# origin, and the native app falls back to http://localhost:5000.
#
# In production set EXPO_PUBLIC_DOMAIN to the host serving the app, e.g.
#   EXPO_PUBLIC_DOMAIN=popmatch.app
# Set EXPO_PUBLIC_API_URL only if the API lives somewhere else entirely.
# EXPO_PUBLIC_DOMAIN=
# EXPO_PUBLIC_API_URL=

# Development only: fill the swipe deck with the hardcoded MOCK_USERS instead
# of real profiles from the users table.
# EXPO_PUBLIC_USE_MOCK_USERS=true

# ─── API server ──────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated sites allowed to call the API from a different origin.
# Unnecessary when one server serves both the app and /api.
# ALLOWED_ORIGINS=https://popmatch.app

# ─── Microsoft / UIUC sign-in ────────────────────────────────────────────────
# Nothing goes here. "Continue with UIUC" is the primary sign-in and is always
# shown; it is configured entirely in the Supabase dashboard under
# Authentication -> Providers -> Azure (client ID + secret from your Azure app
# registration). See SETUP.md for the walkthrough.
